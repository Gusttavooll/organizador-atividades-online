# Segredo compartilhado exigido no header `X-Webhook-Secret` do endpoint
# público de webhook (POST /webhooks/entregas). Gere um valor aleatório
# forte, ex.: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
WEBHOOK_SECRET=troque-este-valor-por-um-segredo-forte

# Origens do frontend autorizadas via CORS, separadas por vírgula. Nunca usar
# "*" em produção.
CORS_ORIGINS=http://localhost:3000

# Limite de requisições aceitas no webhook por origem (IP), em uma janela de
# tempo — proteção básica contra abuso do endpoint público.
WEBHOOK_RATE_LIMIT_MAX=30
WEBHOOK_RATE_LIMIT_JANELA_SEGUNDOS=60

# Token pessoal opcional do GitHub, usado para aumentar o limite de
# requisições à API do GitHub ao enriquecer entregas (sem token, o limite é
# de 60 requisições/hora por IP). Não é obrigatório para rodar localmente.
GITHUB_API_TOKEN=

LOG_LEVEL=INFO
ENVIRONMENT=development
