# URL base da API FastAPI. Exposta ao client (prefixo NEXT_PUBLIC_) porque o
# frontend precisa dela para montar as chamadas de fetch. Nenhum segredo deve
# usar o prefixo NEXT_PUBLIC_ — segredos (tokens de serviço, chaves etc.)
# devem ser lidos apenas em código server-side, sem esse prefixo.
NEXT_PUBLIC_API_URL=http://localhost:8000
